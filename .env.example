# URL da API de Chamados (PHP). Sem ela, o portal roda em modo demonstração com dados fictícios em memória.
# CHAMADOS_API_URL=http://localhost:8080

# Endereço público (Open Graph, canonical e sitemap). Padrão: a demo na Vercel.
# SITE_URL=https://portal-chamados-swart.vercel.app

# Opcionais: IDs públicos do Google Analytics 4 e do Microsoft Clarity (vão para o JavaScript do site).
# Vazios = sem analytics e sem aviso de cookies. Na Vercel: Settings → Environment Variables (e um novo deploy).
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_CLARITY_ID=
